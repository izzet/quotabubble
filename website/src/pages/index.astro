---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const repo = "https://github.com/izzet/quotabubble";
const releases = `${repo}/releases/latest`;
const asset = (name: string) => `${repo}/releases/latest/download/${name}`;
const downloads = [
  { os: "windows", label: "Windows", file: "QuotaBubble-windows-x64.zip" },
  { os: "macos", label: "macOS (Apple Silicon)", file: "QuotaBubble-macos-arm64.dmg" },
  { os: "macos-intel", label: "macOS (Intel)", file: "QuotaBubble-macos-x64.dmg" },
  // TODO: add the Ubuntu .deb here once a release actually ships it (v0.2.4 doesn't).
];
const canonical = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}screenshot-expanded.png`, Astro.site).href;
const ogCard = new URL(`${base}og.png`, Astro.site).href;
const appVersion = "0.2.4";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://iyildirim.com/#person",
      name: "Izzet Yildirim",
      url: "https://iyildirim.com",
      jobTitle: "PhD Candidate & Software Engineer",
      sameAs: ["https://github.com/izzet"],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical}#software`,
      name: "QuotaBubble",
      description:
        "A tiny always-on-top desktop bubble that shows your AI coding usage limits: Claude Code, Codex, Antigravity, Copilot, Cursor, Grok, Zed, Kimi Code, OpenCode, DeepSeek, OpenRouter, and Z.ai.",
      url: canonical,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Windows, macOS, Linux",
      softwareVersion: appVersion,
      isAccessibleForFree: true,
      license: `${repo}/blob/main/LICENSE`,
      image: ogCard,
      screenshot: ogImage,
      downloadUrl: releases,
      author: { "@id": "https://iyildirim.com/#person" },
      creator: { "@id": "https://iyildirim.com/#person" },
      sameAs: [repo, "https://pypi.org/project/quotabubble/"],
    },
  ],
};

const features = [
  ["Frameless bubble", "Translucent, rounded, always on top — and it never steals keyboard focus."],
  ["Fades when idle", "A configurable low opacity keeps it out of the way; hover to bring it back."],
  ["Click to expand", "Every usage window, the percentage used, and a live reset countdown."],
  ["Drag anywhere", "Move it across monitors; its position is remembered."],
  ["Stays accurate", "Refreshes every 5 minutes and keeps the last good values through transient errors."],
  ["Local only", "Reuses the credentials your tools already store. No telemetry, no server."],
];

const providers = [
  ["Claude Code", "macOS Keychain or ~/.claude/.credentials.json"],
  ["Codex", "~/.codex/auth.json"],
  ["Google Antigravity", "Windows Credential Manager, macOS Keychain, or Linux Secret Service"],
  ["GitHub Copilot", "Windows Credential Manager, macOS Keychain, or Linux Secret Service"],
  ["Cursor", "Cursor IDE state.vscdb / auth.json"],
  ["Grok (SuperGrok)", "~/.grok/auth.json from grok login"],
  ["Zed", "Windows Credential Manager (sign in to Zed)"],
  ["Kimi Code", "Kimi Code CLI login in ~/.kimi-code"],
  ["OpenCode", "~/.local/share/opencode/auth.json or an API key"],
  ["DeepSeek", "API key"],
  ["OpenRouter", "API key"],
  ["Z.ai (GLM Coding Plan)", "API key"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>QuotaBubble — your AI usage limits, always in sight</title>
    <meta
      name="description"
      content="A tiny always-on-top desktop bubble that shows your AI coding usage limits: Claude Code, Codex, Antigravity, Copilot, Cursor, Grok, Zed, Kimi Code, OpenCode, DeepSeek, OpenRouter, and Z.ai."
    />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="xOAsL7kCK8dOoM2HfkWJWEI5kKUsRb97HRnRJ6P45cw" />
    <meta name="msvalidate.01" content="8B1609FF4BA356F243940433A8127B56" />
    <meta name="theme-color" content="#0e0e11" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QuotaBubble" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="QuotaBubble — your AI usage limits, always in sight" />
    <meta property="og:description" content="Your AI usage limits, always in sight." />
    <meta property="og:image" content={ogCard} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The QuotaBubble widget showing Claude, Codex and Copilot usage." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="QuotaBubble — your AI usage limits, always in sight" />
    <meta name="twitter:description" content="Your AI usage limits, always in sight." />
    <meta name="twitter:image" content={ogCard} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={base}>
        <img src={`${base}icon.png`} width="28" height="28" alt="" />
        <span>QuotaBubble</span>
      </a>
      <a class="ghost" href={repo}>GitHub →</a>
    </header>

    <main>
      <section class="hero">
        <h1>Your AI usage limits,<br />always in sight.</h1>
        <p class="lede">
          QuotaBubble is a tiny, always-on-top desktop bubble that shows the usage limits for your
          AI coding tools — without opening a dashboard, terminal, or browser. It fades away when
          idle and expands when you click it.
        </p>
        <div class="cta">
          <a class="primary" id="download" href={releases}>Download for Windows, macOS, or Linux</a>
          <a class="secondary" href={repo}>View on GitHub</a>
        </div>
        <p class="alt-downloads" hidden>
          Direct downloads:
          {downloads.map((d) => (
            <a href={asset(d.file)}>{d.label}</a>
          ))}
          <a href={releases}>All releases</a>
        </p>
        <script define:vars={{ downloads: downloads.map((d) => ({ ...d, href: asset(d.file) })) }}>
          // Progressive enhancement: without JS the button just opens the releases page.
          const ua = navigator.userAgent;
          const os = /Android|iPhone|iPad/i.test(ua)
            ? null
            : /Windows/i.test(ua)
              ? "windows"
              : /Macintosh|Mac OS X/i.test(ua)
                ? "macos"
                : /Linux|X11|CrOS/i.test(ua)
                  ? "linux"
                  : null;
          const pick = downloads.find((d) => d.os === os);
          const button = document.getElementById("download");
          if (button && pick) {
            button.href = pick.href;
            button.textContent = `Download for ${pick.os === "macos" ? "macOS" : pick.label}`;
          }
          const alt = document.querySelector(".alt-downloads");
          if (alt) alt.hidden = false;
        </script>
        <div class="shots">
          <img src={`${base}screenshot-compact.png`} width="260" alt="Idle bubble" />
          <img src={`${base}screenshot-expanded.png`} width="300" alt="Expanded detail" />
        </div>
      </section>

      <section>
        <h2>Features</h2>
        <ul class="grid">
          {features.map(([title, body]) => (
            <li>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Supported providers</h2>
        <ul class="providers">
          {providers.map(([name, auth]) => (
            <li>
              <span class="pname">{name}</span>
              <span class="pauth">{auth}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Install</h2>
        <div class="os-tabs" role="tablist" aria-label="Operating system" hidden>
          <button type="button" role="tab" data-os="windows">Windows</button>
          <button type="button" role="tab" data-os="macos">macOS</button>
          <button type="button" role="tab" data-os="linux">Ubuntu GNOME</button>
          <button type="button" role="tab" data-os="source">From source</button>
        </div>

        <div class="os-panel" role="tabpanel" data-os="windows">
          <h3>Windows</h3>
          <p>
            With <a href="https://learn.microsoft.com/windows/package-manager/winget/">winget</a>:
          </p>
          <pre><code>winget install Izzet.QuotaBubble</code></pre>
          <p>
            Or with <a href="https://community.chocolatey.org/packages/quotabubble">Chocolatey</a>:
          </p>
          <pre><code>choco install quotabubble</code></pre>
          <p>
            Or with <a href="https://scoop.sh">Scoop</a>:
          </p>
          <pre><code>scoop bucket add izzet https://github.com/izzet/scoop-bucket
scoop install izzet/quotabubble</code></pre>
          <p>
            Or download the latest <code>QuotaBubble-windows-x64.zip</code> from
            <a href={releases}>Releases</a>, unzip it, and run <code>QuotaBubble.exe</code>.
          </p>
          <p class="note">
            The build is unsigned for now, so SmartScreen may warn you — choose “More info → Run anyway”.
          </p>
        </div>

        <div class="os-panel" role="tabpanel" data-os="macos">
          <h3>macOS</h3>
          <p>
            With <a href="https://brew.sh">Homebrew</a>, using the first-party tap (works on both Apple
            Silicon and Intel):
          </p>
          <pre><code>brew install --cask izzet/tap/quotabubble</code></pre>
          <p>
            Or download the matching disk image from <a href={releases}>Releases</a>:
            <code>QuotaBubble-macos-arm64.dmg</code> for Apple Silicon, or
            <code>QuotaBubble-macos-x64.dmg</code> for Intel. Open it and drag QuotaBubble to Applications.
          </p>
          <p class="note">
            The macOS builds are not yet Developer ID signed or notarized, so Control-click the app,
            choose Open, and confirm the dialog on first launch.
          </p>
        </div>

        <div class="os-panel" role="tabpanel" data-os="linux">
          <h3>Ubuntu GNOME</h3>
          <p>
            Download <code>QuotaBubble-linux-amd64.deb</code> from <a href={releases}>Releases</a>, then
            install it and enable the GNOME extension:
          </p>
          <pre><code>sudo apt install ./QuotaBubble-linux-amd64.deb
gnome-extensions enable quotabubble@izzet.dev</code></pre>
          <p>
            Open <code>quotabubble-settings</code> to choose providers, notifications, and launch at login.
          </p>
        </div>

        <div class="os-panel" role="tabpanel" data-os="source">
          <h3>From source</h3>
          <p>
            With Python 3.11+ and <a href="https://docs.astral.sh/uv/">uv</a>:
          </p>
          <pre><code>{`git clone ${repo}.git
cd quotabubble
uv tool install --editable .
quotabubble`}</code></pre>
          <p>
            Or install it as a standalone command with
            <a href="https://pipx.pypa.io/">pipx</a>: <code>pipx install quotabubble</code>.
          </p>
        </div>

        <script>
          // Progressive enhancement: without JS every panel stays visible, one after another.
          const tabs = [...document.querySelectorAll<HTMLButtonElement>(".os-tabs [data-os]")];
          const panels = [...document.querySelectorAll<HTMLElement>(".os-panel")];
          const bar = document.querySelector<HTMLElement>(".os-tabs");
          const ua = navigator.userAgent;
          const detected = /Android|iPhone|iPad/i.test(ua)
            ? "source"
            : /Windows/i.test(ua)
              ? "windows"
              : /Macintosh|Mac OS X/i.test(ua)
                ? "macos"
                : /Linux|X11|CrOS/i.test(ua)
                  ? "linux"
                  : "windows";

          function select(os: string, focus = false) {
            for (const tab of tabs) {
              const on = tab.dataset.os === os;
              tab.setAttribute("aria-selected", String(on));
              tab.tabIndex = on ? 0 : -1;
              if (on && focus) tab.focus();
            }
            for (const panel of panels) panel.hidden = panel.dataset.os !== os;
          }

          if (bar && tabs.length && panels.length) {
            bar.hidden = false;
            bar.classList.add("on");
            document.querySelector(".os-panel")?.parentElement?.classList.add("tabs-on");
            select(detected);
            tabs.forEach((tab, index) => {
              tab.addEventListener("click", () => select(tab.dataset.os ?? detected));
              tab.addEventListener("keydown", (event) => {
                const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
                if (step) {
                  event.preventDefault();
                  const next = tabs[(index + step + tabs.length) % tabs.length];
                  select(next.dataset.os ?? detected, true);
                }
              });
            });
          }
        </script>
      </section>
    </main>

    <footer>
      <span>MIT licensed</span>
      <span>·</span>
      <a href={repo}>github.com/izzet/quotabubble</a>
      <span>·</span>
      <a href={`${base}privacy/`}>Privacy</a>
    </footer>
    <script>
      // Progressive enhancement: without JS the code blocks simply stay plain.
      for (const pre of document.querySelectorAll("pre")) {
        const wrap = document.createElement("div");
        wrap.className = "codeblock";
        pre.replaceWith(wrap);
        wrap.append(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-btn";
        button.textContent = "Copy";
        button.setAttribute("aria-label", "Copy command to clipboard");
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText.trim());
            button.textContent = "Copied";
          } catch {
            button.textContent = "Press Ctrl+C";
          }
          setTimeout(() => (button.textContent = "Copy"), 1800);
        });
        wrap.append(button);
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #0e0e11;
    --panel: #16161a;
    --line: rgba(255, 255, 255, 0.08);
    --text: #ececf1;
    --dim: #9a9aa5;
    --accent: #5ec584;
    --accent-ink: #06210f;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background:
      radial-gradient(1200px 600px at 50% -200px, rgba(94, 197, 132, 0.12), transparent),
      var(--bg);
    color: var(--text);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  code {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1px 6px;
    font-size: 0.9em;
  }
  pre {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    overflow-x: auto;
  }
  :global(.codeblock) {
    position: relative;
  }
  :global(.codeblock pre) {
    margin: 0 0 16px;
    padding-right: 76px;
  }
  :global(.copy-btn) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 10px;
    font: inherit;
    font-size: 12px;
    color: var(--dim);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    border-radius: 6px;
    cursor: pointer;
  }
  :global(.copy-btn:hover),
  :global(.copy-btn:focus-visible) {
    color: var(--text);
    border-color: var(--accent);
  }
  pre code {
    background: none;
    border: none;
    padding: 0;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 960px;
    margin: 0 auto;
    padding: 20px 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
  }
  .brand img {
    border-radius: 7px;
  }
  .ghost {
    color: var(--dim);
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }
  section {
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 24px;
    letter-spacing: -0.01em;
  }
  h3 {
    font-size: 16px;
    margin: 0 0 4px;
  }
  .hero {
    border-top: none;
    text-align: center;
    padding: 40px 0 24px;
  }
  .hero h1 {
    font-size: clamp(32px, 6vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 8px 0 16px;
  }
  .lede {
    color: var(--dim);
    max-width: 620px;
    margin: 0 auto 28px;
    font-size: 18px;
  }
  .cta {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .primary,
  .secondary {
    display: inline-block;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 600;
  }
  .primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .primary:hover {
    text-decoration: none;
    filter: brightness(1.05);
  }
  .secondary {
    border: 1px solid var(--line);
    color: var(--text);
  }
  .secondary:hover {
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
  }
  .alt-downloads {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--dim);
    display: flex;
    gap: 6px 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .shots {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .shots img {
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.5));
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .grid li {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px;
  }
  .grid p {
    color: var(--dim);
    margin: 0;
  }
  .providers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 8px;
  }
  .providers li {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
  }
  .pname {
    font-weight: 600;
    flex-shrink: 0;
  }
  .pauth {
    min-width: 0;
    color: var(--dim);
    font-size: 13px;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .os-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 16px;
  }
  .os-tabs button {
    padding: 6px 14px;
    font: inherit;
    font-size: 14px;
    color: var(--dim);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .os-tabs button:hover,
  .os-tabs button:focus-visible {
    color: var(--text);
    border-color: var(--accent);
  }
  .os-tabs button[aria-selected="true"] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }
  .tabs-on .os-panel > h3 {
    display: none;
  }
  .note {
    color: var(--dim);
    font-size: 14px;
  }
  footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 32px 24px 48px;
    color: var(--dim);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid var(--line);
  }
</style>
